# Copy to .env for local development. Never commit real values.
# Client (Vite) — these are public in the browser bundle.
# Restrict the Firebase web API key by HTTP referrer in Google Cloud Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Defaults to /api/tutor (Vite middleware, Netlify, or Vercel).
VITE_TUTOR_API_URL=

# Server only — do NOT prefix with VITE_ (that would leak into the client bundle).
GEMINI_API_KEY=
FIREBASE_WEB_API_KEY=

# Comma-separated allow-list for the tutor API Origin header.
# Example: http://localhost:3000,https://e-prayog09.netlify.app
ALLOWED_ORIGINS=http://localhost:3000,https://e-prayog09.netlify.app
