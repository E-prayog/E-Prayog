rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function getUserData() {
      return exists(userPath(request.auth.uid)) ? get(userPath(request.auth.uid)).data : null;
    }

    function getRole() {
      let data = getUserData();
      return data != null ? data.get('role', 'Student') : 'Student';
    }

    function isTeacher() {
      return isAuthenticated() && getRole() == 'Teacher';
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'Admin';
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSelf(userId)
        || isAdmin()
        || (isTeacher() && resource.data.get('teacherUid', '') == request.auth.uid);

      allow create: if (isSelf(userId) && request.resource.data.role == 'Student') || isAdmin();

      allow update: if isAdmin()
        || (
          isSelf(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'teacherUid', 'teacherCode', 'classCode', 'class_code'])
        )
        || (
          isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['teacherUid', 'teacherCode', 'teacherName', 'updatedAt'])
          && request.resource.data.role == resource.data.role
        )
        || (
          isSelf(userId)
          && isTeacher()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['classCode', 'class_code', 'updatedAt'])
        )
        || (
          isTeacher()
          && resource.data.get('teacherUid', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['teacherUid', 'teacherCode', 'teacherName', 'updatedAt'])
        );

      allow delete: if isAdmin();
    }

    match /labProgress/{uid}/labs/{labId} {
      allow read: if isSelf(uid)
        || isAdmin()
        || (isTeacher() && exists(userPath(uid)) && get(userPath(uid)).data.get('teacherUid', '') == request.auth.uid);
      allow create, update: if isSelf(uid);
      allow delete: if isAdmin();
    }

    match /teachers/{teacherUid} {
      allow read: if isSelf(teacherUid) || isAdmin();
      allow create, update: if isSelf(teacherUid) || isAdmin();
      allow delete: if isAdmin();

      match /students/{studentUid} {
        allow read: if isSelf(teacherUid) || isSelf(studentUid) || isAdmin();
        allow create, update, delete: if isSelf(studentUid) || isSelf(teacherUid) || isAdmin();
      }
    }

    match /teacherCodes/{code} {
      allow read: if isAuthenticated();
      allow create, update: if isTeacher()
        && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /passwordResets/{uid} {
      allow read, write: if false;
    }

    match /passwordResetRequests/{requestId} {
      allow read: if isAdmin() || isTeacher();
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['status'])
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /activityFeed/{activityId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.actorUid == request.auth.uid)
        || (isTeacher()
          && exists(userPath(resource.data.actorUid))
          && get(userPath(resource.data.actorUid)).data.get('teacherUid', '') == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.actorUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /feedbacks/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 20
        && request.resource.data.message.size() <= 4000
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    match /quiz_scores/{scoreId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.user_id
        || isAdmin()
        || (isTeacher()
          && exists(userPath(resource.data.user_id))
          && get(userPath(resource.data.user_id)).data.get('teacherUid', '') == request.auth.uid)
      );
      allow create, update: if isAuthenticated()
        && request.auth.uid == request.resource.data.user_id;
      allow delete: if isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        isAdmin()
        || resource.data.teacherUid == request.auth.uid
        || resource.data.get('teacherUid', '') == request.auth.uid
      );
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    match /customQuizzes/{quizId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isTeacher();
    }

    match /aiUsage/{uid}/days/{day} {
      allow read, write: if isSelf(uid);
    }
  }
}
