rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Core Auth Check ────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // ── Safe Role Lookup ───────────────────────────────────────
    // Returns null (never throws) if the user doc is missing.
    // This avoids the chicken-and-egg deadlock on first login.
    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function getRole() {
      let data = getUserData();
      return data != null ? data.get('role', 'Student') : 'Student';
    }

    function isTeacher() {
      return isAuthenticated() && getRole() == 'Teacher';
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'Admin';
    }

    // ── Users Collection ───────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read any profile.
      // This is required for teacher-student lookups and profile loading.
      allow read: if isAuthenticated();

      // A user can create their OWN profile (needed for first-login provisioning),
      // OR an admin can create any profile (for teacher provisioning).
      // We intentionally allow self-creation without the isAdmin() check to break the deadlock.
      allow create: if isAuthenticated() && (
        request.auth.uid == userId ||
        getRole() == 'Admin'
      );

      // Users can update their own profile but CANNOT change their own role.
      // Admins can update any profile including role changes.
      allow update: if isAuthenticated() && (
        getRole() == 'Admin' ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        )
      );

      allow delete: if isAdmin();
    }

    // ── Lab Progress ───────────────────────────────────────────
    match /labProgress/{uid}/labs/{labId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == uid || isTeacher() || isAdmin()
      );
      allow create, update: if isAuthenticated() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // ── Teachers Collection ────────────────────────────────────
    match /teachers/{teacherUid} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        request.auth.uid == teacherUid || isAdmin()
      );
      allow delete: if isAdmin();

      match /students/{studentUid} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && (
          request.auth.uid == studentUid ||
          request.auth.uid == teacherUid ||
          isAdmin()
        );
      }
    }

    // ── Teacher Codes ──────────────────────────────────────────
    match /teacherCodes/{code} {
      // Any authenticated user can read (needed to resolve teacher code on signup)
      allow read: if isAuthenticated();
      // Teachers and Admins can create/update codes
      allow create, update: if isAuthenticated() && (isTeacher() || isAdmin());
      // Also allow the owning teacher to write their own code
      allow create, update: if isAuthenticated() && (
        resource == null || resource.data.teacherUid == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // ── Password Resets ────────────────────────────────────────
    match /passwordResets/{uid} {
      // Only the target user can read their own reset, or admin
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Password Reset Requests ────────────────────────────────
    match /passwordResetRequests/{requestId} {
      // Admins and Teachers can see pending requests
      allow read: if isAuthenticated() && (isAdmin() || isTeacher());
      // Any authenticated user can submit a reset request (e.g. locked-out teacher)
      allow create: if isAuthenticated();
      // Only admin can update (resolve) or delete requests
      allow update, delete: if isAdmin();
    }

    // ── Activity Feed ──────────────────────────────────────────
    match /activityFeed/{activityId} {
      allow read: if isAuthenticated();
      // Allow any authenticated user to log activity for themselves.
      // The actorUid check is relaxed here to allow system-level calls during login.
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Feedbacks ──────────────────────────────────────────────
    match /feedbacks/{feedbackId} {
      allow read: if isAuthenticated() && (isAdmin() || isTeacher());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Quiz Scores ────────────────────────────────────────────
    match /quiz_scores/{scoreId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.user_id ||
        isTeacher() ||
        isAdmin()
      );
      allow create, update: if isAuthenticated() && (
        request.auth.uid == request.resource.data.user_id
      );
      allow delete: if isAdmin();
    }

    // ── Assignments ────────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    // ── Custom Quizzes (Admin & Teacher Designer) ────────────────
    match /customQuizzes/{quizId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && (isAdmin() || isTeacher());
    }
  }
}
